# The selected APIs do not require API keys for this project.
# Add provider keys here if you later switch to a paid data source.
NEXT_PUBLIC_APP_NAME=BoranTheGreat
NEXT_PUBLIC_SITE_URL=https://boranthegreat.xyz

# Optional: enables the AI assistant's OpenAI powered mode.
# Without this key, the assistant still works in local smart mode.
# Add this in Vercel Project Settings > Environment Variables for production.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Cloudflare Turnstile
# Site key is public and is used by the browser.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Secret key must stay server-side and must never be committed to GitHub.
TURNSTILE_SECRET_KEY=
